# Supabase PostgreSQL connection strings
# Get these from Supabase Dashboard > Project Settings > Database
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development

# CORS - your deployed Vercel frontend URL(s), comma-separated
CORS_ORIGIN="http://localhost:5173,https://your-app.vercel.app"
